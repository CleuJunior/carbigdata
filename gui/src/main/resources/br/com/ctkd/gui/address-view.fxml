<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.ctkd.gui.controller.AddressController"
      spacing="14">

    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="Addresses" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Refresh" onAction="#handleRefresh" styleClass="secondary-button"/>
        <Button text="+ Add New" onAction="#handleAddNew" styleClass="primary-button"/>
    </HBox>

    <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true" maxWidth="Infinity"/>

    <!-- Table -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="streetCol" text="Street" prefWidth="160"/>
            <TableColumn fx:id="neighborhoodCol" text="Neighborhood" prefWidth="130"/>
            <TableColumn fx:id="zipCol" text="ZIP" prefWidth="90"/>
            <TableColumn fx:id="cityCol" text="City" prefWidth="110"/>
            <TableColumn fx:id="stateCol" text="State" prefWidth="55"/>
            <TableColumn fx:id="creationDateCol" text="Created At" prefWidth="140"/>
            <TableColumn fx:id="updateDateCol" text="Updated At" prefWidth="140"/>
            <TableColumn fx:id="deletedCol" text="Deleted" prefWidth="70"/>
        </columns>
        <placeholder><Label text="No addresses found."/></placeholder>
    </TableView>

</VBox>
