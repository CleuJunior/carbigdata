<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.ctkd.gui.controller.MainController">

    <left>
        <VBox styleClass="sidebar" prefWidth="200" spacing="4">
            <padding>
                <javafx.geometry.Insets top="24" right="12" bottom="24" left="12"/>
            </padding>

            <Label text="CarBigData" styleClass="brand"/>

            <Separator>
                <VBox.margin><javafx.geometry.Insets top="8" bottom="8"/></VBox.margin>
            </Separator>

            <Button fx:id="clientsBtn" text="Clients" onAction="#showClients"
                    styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="addressesBtn" text="Addresses" onAction="#showAddresses"
                    styleClass="nav-btn" maxWidth="Infinity"/>
            <Button fx:id="occurrencesBtn" text="Occurrences" onAction="#showOccurrences"
                    styleClass="nav-btn" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Logout" onAction="#handleLogout"
                    styleClass="nav-btn,nav-logout" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-area"/>
    </center>

</BorderPane>
