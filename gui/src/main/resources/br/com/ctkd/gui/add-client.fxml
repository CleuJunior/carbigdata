<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.com.ctkd.gui.controller.AddClientController"
      spacing="14" prefWidth="460" prefHeight="520">

    <!-- Top bar -->
    <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="8">
        <padding>
            <Insets top="12" right="20" bottom="12" left="20"/>
        </padding>
        <Label text="CarBigData" styleClass="top-bar-brand"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Logout" onAction="#handleLogout" styleClass="secondary-button"/>
    </HBox>

    <!-- Form -->
    <VBox spacing="14">
        <padding>
            <Insets top="8" right="40" bottom="24" left="40"/>
        </padding>

        <Label text="Add New Client" styleClass="section-title"/>

        <VBox spacing="6">
            <Label text="Full Name" styleClass="field-label"/>
            <TextField fx:id="nameField" promptText="e.g. João Silva" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Date of Birth" styleClass="field-label"/>
            <DatePicker fx:id="birthdatePicker" promptText="dd/MM/yyyy" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6">
            <Label text="CPF" styleClass="field-label"/>
            <TextField fx:id="cpfField" promptText="000.000.000-00" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="statusLabel" visible="false" managed="false" wrapText="true" maxWidth="Infinity"/>

        <Region prefHeight="6"/>

        <Button fx:id="saveButton" text="Add Client" onAction="#handleSave"
                styleClass="primary-button" maxWidth="Infinity"/>
    </VBox>

</VBox>
